# Google AI Studio Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEYS=your_first_key_here,your_second_key_here

# Local Server Port (default: 8088)
PORT=8088

# =============================================================================
# OPTIONAL AFFILIATE PARTNER CREDENTIALS (MONETIZATION)
# When provided, all store buttons automatically inject your partner tokens.
# When left blank, clean search links are used as fallback.
# =============================================================================
# eBay Partner Network Campaign ID (10-digit number from partnernetwork.ebay.com)
EBAY_CAMPAIGN_ID=

# Amazon Associates Tracking IDs (e.g. vinyltipper-21 for DE, vinyltipper-20 for US)
AMAZON_TAG_DE=
AMAZON_TAG_US=
AMAZON_TAG_UK=

# Awin Publisher ID (for jpc.de and HHV.de affiliate programs)
AWIN_PUBLISHER_ID=

# Discogs Affiliate Token (optional)
DISCOGS_AFFILIATE_ID=
